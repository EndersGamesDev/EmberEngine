/target
**/*.rs.bk
*.pdb
# generated wasm bindings (built by CI/deploy, not source)
/web/pkg/
/web/games/*/*/pkg/

# Local AI-orchestration working notes
/.claude/
assets/swat/
assets/swat-operator-remastered.zip
assets/9mm/
assets/9-mm.zip
# Build ticker, generated at publish time by deploy/stamp-version.sh. Not
# committed: a stamped-then-committed file always names the commit BEFORE
# itself, so the ticker would be permanently one build stale.
/web/version.json
# Minted on gh-pages by deploy-pages.sh; a local copy is only test scaffolding.
/web/server.json
.watchdog-state
# Arena v13 asset runbook (tools/v13): generated pictures are regenerable from
# the prompt tables in gen_textures.py / gen_views.py, so the 65 MB raw set is
# NOT committed; only the baked assets/textures/v13 and assets/models/v13 are.
# Run logs, screenshots, bytecode and the placeholder generator stay local.
/assets/concepts/v13/
/tools/v13/*.log
/tools/v13/*.err
/tools/v13/*.png
/tools/v13/__pycache__/
/tools/v13/placeholder.py
/tools/v13/nightcoder-audit.md
# Artist sources for the v15 viewmodel (large; converted GLBs are committed)
assets/revolver/
assets/hands/
assets/*.zip
# v15 viewmodel runbook: previews, captures and bytecode stay local
/tools/v15/*.png
/tools/v15/__pycache__/
# v16 viewmodel runbook: previews, captures and bytecode stay local
/tools/v16/*.png
/tools/v16/__pycache__/
# v17 artist sources: the scutum and the Murasama (large; converted GLB is committed)
assets/scutum/
assets/murasama/
/tools/v17/*.png
/tools/v17/__pycache__/
