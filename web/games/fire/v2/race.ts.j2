    import { chooseHost, listLobbies, probeHost, rankHosts, renderChip }
      from '../../../hosts.js';
    import type { HostView } from '../../../hosts.js';
    import { vehicles, selectedVehicle, formatTime, EngineAudio } from './garage.js';
    import type { HudSnapshot } from './garage.js';

    type UnknownRecord = Record<string, unknown>;
    type LoaderModule = typeof import('../../../loader.js');
    type FireWasmModule = typeof import('../../../wasm/fire/fire.js');
    type FireWasm = Pick<FireWasmModule,
      'hud_json' | 'online_status' | 'package_version' | 'proto_version'
      | 'restart_local' | 'start_local_vehicle' | 'start_online'>;
    export type FireProtocolBoundary = C2SOutput | S2CInput;

    interface FireLoaderEvent extends Event {
      host?: HostView | null;
      candidates?: HostView[];
      wrongProto?: HostView[];
      proto?: number | null;
    }

    interface PendingLaunch {
      lobby: unknown;
      ws: unknown;
      host: unknown;
      password: unknown;
      action: unknown;
    }

    const $ = (id: string): HTMLElement => {
      const found = document.getElementById(id);
      if (!found) throw new Error(`missing Fire page element #${id}`);
      return found;
    };
    const button = (id: string): HTMLButtonElement => {
      const found = $(id);
      if (!(found instanceof HTMLButtonElement)) throw new Error(`Fire page element #${id} is not a button`);
      return found;
    };
    const input = (id: string): HTMLInputElement => {
      const found = $(id);
      if (!(found instanceof HTMLInputElement)) throw new Error(`Fire page element #${id} is not an input`);
      return found;
    };
    const fireWasmFrom = (value: unknown): FireWasm => {
      if (!value || (typeof value !== 'object' && typeof value !== 'function')) {
        throw new Error('the Fire wasm module is not an object');
      }
      for (const name of [
        'hud_json', 'online_status', 'package_version', 'proto_version',
        'restart_local', 'start_local_vehicle', 'start_online',
      ] as const) {
        if (typeof Reflect.get(value, name) !== 'function') {
          throw new Error(`the Fire wasm module has no ${name} function`);
        }
      }
      return value as FireWasm;
    };
    const hudFrom = (value: unknown): value is HudSnapshot => {
      if (!value || typeof value !== 'object' || Array.isArray(value)) return false;
      const hud = value as UnknownRecord;
      for (const key of [
        'speed', 'lap', 'laps', 'place', 'racers', 'boost', 'countdown', 'item',
        'vehicle', 'gear', 'race_time', 'drift_charge', 'shield', 'grip', 'hit',
      ] as const) {
        if (typeof hud[key] !== 'number') return false;
      }
      for (const key of ['boosting', 'drifting', 'finished'] as const) {
        if (typeof hud[key] !== 'boolean') return false;
      }
      return true;
    };
    const lobbyFrom = (value: unknown): LobbyInfoInput | null => {
      if (!value || typeof value !== 'object' || Array.isArray(value)) return null;
      const lobby = value as UnknownRecord;
      if (typeof lobby['name'] !== 'string'
          || typeof lobby['host'] !== 'string'
          || typeof lobby['has_password'] !== 'boolean'
          || typeof lobby['players'] !== 'number'
          || typeof lobby['cap'] !== 'number'
          || (lobby['racing'] !== undefined && typeof lobby['racing'] !== 'boolean')) return null;
      return lobby as LobbyInfoInput;
    };
    const pendingFrom = (value: unknown): PendingLaunch | null => {
      if (!value || typeof value !== 'object' || Array.isArray(value)) return null;
      return {
        lobby: Reflect.get(value, 'lobby'),
        ws: Reflect.get(value, 'ws'),
        host: Reflect.get(value, 'host'),
        password: Reflect.get(value, 'password'),
        action: Reflect.get(value, 'action'),
      };
    };
    const loaderFrom = (value: unknown): Pick<LoaderModule, 'emberLoad'> => {
      if (!value || typeof value !== 'object'
          || typeof Reflect.get(value, 'emberLoad') !== 'function') {
        throw new Error('the Fire page loader has no emberLoad function');
      }
      return value as Pick<LoaderModule, 'emberLoad'>;
    };
    const LOADER_URL = '../../../loader.js?v=1';
    const { emberLoad } = loaderFrom(await import(LOADER_URL));
    const sound = new EngineAudio();
    let practice = true;
    let resultsShown = false;
    let awaitingRestart = false;
    const fail = (msg: unknown): void => {
      const el = document.getElementById('loading');
      if (el) el.textContent = 'failed to start: ' + String(msg || 'see browser console');
      $('engine-note').textContent = 'Could not load the race. Reload to try again. ' + String(msg || '');
      $('engine-note').className = 'note bad';
      if(!$('stage').classList.contains('hidden')) {
        $('results').classList.remove('hidden');
        $('result-title').textContent = 'RACE INTERRUPTED';
        $('session-note').textContent = String(msg || 'Reload the garage to try again.');
        $('btn-rematch').classList.add('hidden');
      }
    };
    window.addEventListener('error', (e) => fail(e.message));
    window.addEventListener('unhandledrejection', (e) => fail(e.reason));
    // Stop the arrow keys and space scrolling the page out from under the race.
    addEventListener('keydown', (e: KeyboardEvent) => {
      const tagName = e.target instanceof HTMLElement ? e.target.tagName : '';
      if (!['INPUT','TEXTAREA'].includes(tagName) && ['ArrowUp','ArrowDown','ArrowLeft','ArrowRight',' '].includes(e.key) && !$('stage').classList.contains('hidden')) e.preventDefault();
    }, { passive: false });
    $('ember-root').addEventListener('pointerdown', () => document.querySelector<HTMLElement>('#ember-root canvas')?.focus());
    button('sound-toggle').onclick = () => {
      const on = sound.toggle();
      $('sound-toggle').textContent = on ? 'SOUND ON' : 'SOUND OFF';
      $('sound-toggle').setAttribute('aria-pressed', String(on));
      if(on) sound.start().catch(()=>{});
      document.querySelector<HTMLElement>('#ember-root canvas')?.focus();
    };
    document.addEventListener('visibilitychange', () => {
      if(sound.ctx) { if(document.hidden) sound.ctx.suspend(); else if(sound.enabled) sound.ctx.resume(); }
    });
    button('btn-garage').onclick = () => location.assign('./');
    button('btn-rematch').onclick = () => {
      if(!practice) { location.assign('./'); return; }
      wasm.restart_local(selectedVehicle());
      awaitingRestart = true;
      resultsShown = false;
      $('results').classList.add('hidden');
      sound.start().catch(()=>{});
      document.querySelector<HTMLElement>('#ember-root canvas')?.focus();
    };

    const ROOT = new URL('../../../', location.href);

    // The loader emits, this page renders. The two lines a driver already
    // watches carry it: the note under the stage and the placeholder inside
    // it. Before this, both said "first load may take a moment" and then
    // nothing for the rest of the download.
    let chosen: HostView | null = null;       // the host we will race on
    let candidates: HostView[] = [];          // it, then the fallbacks, in order
    let wrongProto: HostView[] = [];          // answered, but speaking another protocol
    let PROTO = 0;           // the bundle confirms this after the early ranking
    function paint(e: FireLoaderEvent): void {
      if (e.phase === 'host') {
        if (e.status !== 'begin') {
          // The background post-bundle retry updates launch state and the chip
          // after load resolves, even while the online panel is still closed.
          chosen = e.host || null;
          candidates = e.candidates || [];
          wrongProto = e.wrongProto || [];
          if (typeof e.proto === 'number') PROTO = e.proto;
          renderChip($('host-chip'), chosen, { wrongProto, proto: e.proto ?? null });
        }
        return;
      }
      if (e.phase !== 'ready') $('engine-note').textContent = e.text;
      const el = document.getElementById('loading');
      if (el) el.textContent = e.text;
      if (e.status === 'fail') fail(e.text);
    }

    // The bundle and the host together. Fire Racer has never had a manual URL
    // override — the one in the hub's server settings is the arena's address
    // and pointing this page at it would be a worse bug than having no
    // override at all — so the address book is the only source here, and the
    // protocol comes from this page's catalog entry rather than its bundle.
    const ember = await emberLoad({
      game: 'fire',
      version: 'v2',
      bundle: './pkg/fire.js',
      onEvent: paint,
    });
    const wasm = fireWasmFrom(ember.exports);
    const FULL_VERSION = ember.version || wasm.package_version();
    const VERSION_LABEL = `Version ${FULL_VERSION.split('.')[0]}`;
    $('release-version').textContent = VERSION_LABEL;
    $('release-version').title = `Full version ${FULL_VERSION}`;
    document.title = `Fire Racer · ${VERSION_LABEL} · Ember`;
    PROTO = typeof ember.proto === 'number' ? ember.proto : wasm.proto_version();
    button('btn-practice').disabled = false;
    button('btn-online').disabled = false;
    $('btn-practice').textContent = 'Start race ↗';
    $('engine-note').textContent = 'Ready to race. Seven AI opponents. No account needed.';

    // ---- host discovery ----------------------------------------------------
    chosen = ember.host;
    candidates = ember.candidates;
    wrongProto = ember.wrongProto;
    // Declared here rather than beside the launchers: `discover()` reads it to
    // drop a probe that finished after a launch had already committed.
    let launched = false;

    // One address, probed once, dressed as a ranked candidate so everything
    // downstream deals with exactly one shape.
    async function onlyHost(url: unknown): Promise<ReturnType<typeof rankHosts>> {
      const entry = { name: '', fire_ws: url, version: '', commit: '', updated: '' };
      const probes = new Map([['', await probeHost(url, { proto: PROTO })]]);
      return rankHosts([entry], { game: 'fire', probes });
    }

    async function discover(): Promise<void> {
      const r = await chooseHost(ROOT.href, { game: 'fire', proto: PROTO });
      if (launched) return; // a race started while the probes were out
      chosen = r.chosen;
      candidates = r.candidates;
      wrongProto = r.wrongProto || [];
      renderChip($('host-chip'), chosen, { wrongProto, proto: PROTO });
    }

    // "Nothing answered" and "everything answered on another protocol" are
    // different news: the second still has a playable build behind it, and it
    // is exactly what a protocol bump looks like from the page that shipped
    // first.
    const offlineText = (): string => (wrongProto.length
      ? `${wrongProto[0]?.name || 'the server'} is on protocol ${wrongProto[0]?.proto} and this build speaks ${PROTO}`
        + ' — open the games page and pick the build that matches'
      : 'no online server is published right now — practice mode still works');

    // ---- lobby browser -----------------------------------------------------
    // Its own short-lived socket, exactly like the arena's. The engine loop
    // never sees a menu. The chosen host's lobbies come first and every other
    // host on this protocol below, each row tagged: two people who landed on
    // different machines still have to be able to find each other.
    const showLobbies = async ({ quiet = false }: { quiet?: boolean } = {}): Promise<void> => {
      const rows = $('lobby-rows');
      const note = (text: string, bad = false): void => {
        const s = document.createElement('span');
        s.className = 'note' + (bad ? ' bad' : '');
        s.textContent = text;
        rows.replaceChildren(s);
      };
      // The placeholder belongs to the first look only. This function empties
      // the list BEFORE it awaits the probes, so a polled call that showed it
      // would blank a populated list every ten seconds — and take the Join
      // button out from under the cursor with it.
      if (!quiet) note('looking for lobbies…');
      await discover();
      if (!candidates.length) {
        note(offlineText());
        return;
      }

      const lists = await Promise.all(candidates.map((c) => listLobbies(c.url, { proto: PROTO })));
      const all: Array<{ host: HostView; lobby: LobbyInfoInput }> = [];
      candidates.forEach((host, i) => {
        for (const value of lists[i] ?? []) {
          const lobby = lobbyFrom(value);
          if (lobby) all.push({ host, lobby });
        }
      });
      if (!all.length) { note('no lobbies yet — create one below'); return; }

      rows.replaceChildren(...all.map(({ host, lobby: l }) => {
        const row = document.createElement('div');
        row.className = 'lobby';
        const nm = document.createElement('span');
        nm.className = 'nm';
        nm.textContent = l.name + (l.has_password ? ' 🔒' : '');
        const meta = document.createElement('span');
        meta.className = 'meta';
        meta.textContent = `${l.players}/${l.cap} · host ${l.host}${l.racing ? ' · racing' : ''}`;
        const tag = document.createElement('span');
        tag.className = 'pill';
        tag.textContent = host.name || 'server';
        tag.title = host.url;
        const go = document.createElement('button');
        go.textContent = 'Join';
        go.onclick = () => {
          const pass = l.has_password ? prompt(`Password for "${l.name}"`) : null;
          if (l.has_password && pass === null) return;
          launchOnline(l.name, pass, false, host); // this row's host, not the chosen one
        };
        row.append(nm, meta, tag, go);
        return row;
      }));
    };

    // ---- the menu poll -----------------------------------------------------
    // The arena's cadence, and the contract in docs/hosts.md §5: the menu
    // re-ranks as it re-lists, so a host that dies while the player reads the
    // panel leaves the chip and the fallback list instead of sitting there
    // looking playable — and a lobby someone else opens ten seconds from now
    // appears without anyone pressing Refresh. It stops the moment the page
    // goes online.
    let lobbyPoll: ReturnType<typeof setInterval> | null = null;
    let ticking = false;
    async function tick(): Promise<void> {
      if (ticking) return;
      ticking = true;
      try { await showLobbies({ quiet: true }); } finally { ticking = false; }
    }
    const pollOn = (): void => { if (lobbyPoll === null) lobbyPoll = setInterval(tick, 10000); };
    const pollOff = (): void => { if (lobbyPoll !== null) { clearInterval(lobbyPoll); lobbyPoll = null; } };

    // ---- launching ---------------------------------------------------------
    const showStage = (): void => {
      $('start').classList.add('hidden');
      $('stage').classList.remove('hidden');
      $('session-toolbar').classList.remove('hidden');
      document.body.classList.add('racing');
    };

    const launchLocal = (): void => {
      if (launched) return;
      launched = true;
      practice = true;
      sound.start().catch(()=>{});
      pollOff(); // practice hides the panel; it must not keep opening sockets
      showStage();
      try { wasm.start_local_vehicle(selectedVehicle()); }
      catch(e) { fail(e); return; }
      pollHud();
    };

    const launchOnline = async (
      lobby: unknown,
      password: unknown,
      create: boolean,
      target: HostView | null,
    ): Promise<void> => {
      if (launched) return;
      sound.start().catch(()=>{});
      const wanted = target || chosen;
      const note = $('online-note');
      if (!wanted) {
        note.className = 'note bad';
        note.textContent = offlineText();
        pollOn(); // includes a handover whose host is already gone: keep looking
        return;
      }
      launched = true;
      pollOff();

      // Probe again RIGHT before the engine takes the socket. The list can be
      // seconds old and a quick tunnel dies without warning; once the wasm
      // client owns the connection there is no failover left, so this is the
      // last moment a dead host can still be turned into a live one.
      note.className = 'note';
      note.textContent = 'connecting…';

      // A Create walks the fallbacks — one server is as good as another for a
      // new lobby. A JOIN does not: that lobby lives on that machine and
      // nowhere else, so walking on would put the player in a stranger's
      // lobby of the same name, or in none, and tell them it "moved". The
      // `wanted === chosen` arm keeps the failover for the address-less
      // handover below, where the target came from the ranking, not a row.
      const order = create
        ? [wanted, ...candidates.filter((c) => c.url !== wanted.url)]
        : [wanted];
      let live: HostView | null = null;
      for (const c of order) {
        // Serial on purpose: the next host only matters once this one failed.
        const p = await probeHost(c.url, { proto: PROTO, timeoutMs: 3000 });
        if (p.ok) { live = c; break; }
      }
      if (!live) {
        launched = false;
        note.className = 'note bad';
        note.textContent = order.length === 1
          ? `${wanted.name || 'that lobby’s host'} stopped answering — the lobby may be gone`
          : 'no server answered — try again in a moment';
        pollOn();
        tick();
        return;
      }
      if (live.url !== wanted.url) {
        note.textContent =
          `${wanted.name || 'that server'} stopped answering — moved to ${live.name || 'another server'}`;
      }
      chosen = live;
      renderChip($('host-chip'), live, { proto: PROTO });

      showStage();
      practice = false;
      $('btn-rematch').textContent = 'Find another race ↗';
      try {
        wasm.start_online(JSON.stringify({
          ws: live.url,
          handle: (input('handle').value || 'driver').trim(),
          lobby, password: password || '', create, vehicle: selectedVehicle(),
        }));
        pollHud();
      } catch (e) {
        launched = false;
        $('stage').classList.add('hidden');
        $('start').classList.remove('hidden');
        $('session-toolbar').classList.add('hidden');
        document.body.classList.remove('racing');
        note.className = 'note bad';
        note.textContent = String(e);
        pollOn();
      }
    };

    button('btn-practice').onclick = launchLocal;
    button('btn-online').onclick = () => {
      $('online-panel').classList.toggle('hidden');
      $('btn-online').classList.add('primary');
      $('btn-practice').classList.remove('primary');
      if (!$('online-panel').classList.contains('hidden')) { showLobbies(); pollOn(); }
      else pollOff(); // a closed panel polls nothing
    };
    // Not `= showLobbies`: the handler would hand the click event in as the
    // options object.
    button('btn-refresh').onclick = () => { void showLobbies(); };
    button('btn-create').onclick = () => {
      const name = (input('newlobby').value || '').trim();
      if (!name) { $('online-note').className = 'note bad'; $('online-note').textContent = 'give the lobby a name'; return; }
      void launchOnline(name, (input('newpass').value || '').trim(), true, chosen);
    };

    // ---- a join handed over from the hub's live-lobby showcase
    // The hub already picked the machine: this lobby lives on THAT host and
    // nowhere else, so its address is used verbatim with no re-ranking. It is
    // still probed once, so a dead handover says so instead of hanging.
    let pending: PendingLaunch | null = null;
    try {
      const parsed: unknown = JSON.parse(sessionStorage.getItem('ember-pending') ?? 'null');
      pending = pendingFrom(parsed);
    } catch {}
    sessionStorage.removeItem('ember-pending');
    if (pending && pending.lobby) {
      $('online-panel').classList.remove('hidden');
      $('btn-online').classList.add('primary');
      $('btn-practice').classList.remove('primary');
      if (pending.ws) {
        const r = await onlyHost(pending.ws);
        chosen = r.chosen;
        candidates = r.candidates;
        wrongProto = r.wrongProto || [];
      } else {
        // A handover from a page that predates the host list: no address came
        // with it, so the normal pick applies — and the loader has made it.
        renderChip($('host-chip'), chosen, { wrongProto, proto: PROTO });
      }
      if (chosen && pending.host) chosen.name = chosen.name || String(pending.host);
      renderChip($('host-chip'), chosen, { wrongProto, proto: PROTO });
      // No poll here: this branch opens the panel only to race straight into
      // the handed-over lobby. `launchOnline` starts one if that fails.
      void launchOnline(pending.lobby, pending.password, pending.action === 'create', chosen);
    } else {
      // The loader ranked once on load, so the chip is honest before anyone
      // opens the online panel; the panel's own refresh re-ranks from there.
      // Painted here as well as from the event, because a loader that could
      // not start still discovers and then there are no events to paint from.
      renderChip($('host-chip'), chosen, { wrongProto, proto: PROTO });
    }

    // ---- HUD ---------------------------------------------------------------
    // The renderer has one scene pass, no 2D layer and no text, so the HUD
    // lives here and reads a snapshot the game publishes every frame.
    const speedEl = document.querySelector('#speed .n');
    const lapEl = document.querySelector('#lap .n');
    if (!speedEl || !lapEl) throw new Error('the Fire HUD is missing speed or lap output');
    const placeEl = $('place');
    const boostEl = $('boost');
    const stateEl = $('state');
    const driftEl = $('drift');
    const MAX_BOOST = 3;
    const items = [
      ['?', 'EMPTY', 'DRIVE THROUGH A BOX'], ['ϟ', 'NITRO', 'E / ACCELERATE'],
      ['◇', 'SHIELD', 'E / PROTECT'], ['◎', 'PULSE', 'E / ATTACK'],
      ['≋', 'OIL SLICK', 'E / DROP'], ['⌁', 'GRIP', 'E / CORNER FASTER'],
    ] as const;
    let pips: HTMLDivElement[] = [];

    const setPips = (n: number): void => {
      if (pips.length !== MAX_BOOST) {
        boostEl.querySelectorAll('.pip').forEach((p) => p.remove());
        pips = Array.from({ length: MAX_BOOST }, () => {
          const d = document.createElement('div');
          d.className = 'pip';
          boostEl.appendChild(d);
          return d;
        });
      }
      pips.forEach((p, i) => p.classList.toggle('on', i < n));
    };

    const pollHud = (): void => {
      const hud = $('hud');
      const tick = (): void => {
        try {
          const parsed: unknown = JSON.parse(wasm.hud_json());
          if (!hudFrom(parsed)) throw new Error('the Fire wasm returned an invalid HUD snapshot');
          const h = parsed;
          if(awaitingRestart) {
            if(h.finished) { requestAnimationFrame(tick); return; }
            awaitingRestart = false;
          }
          if(!h.finished && resultsShown) {
            resultsShown = false;
            $('results').classList.add('hidden');
          }
          hud.classList.add('live');
          speedEl.textContent = String(Math.round(h.speed));
          lapEl.textContent = `${Math.min(h.lap + 1, h.laps)}/${h.laps}`;
          placeEl.textContent = `${h.place}/${h.racers}`;
          setPips(h.boost);
          $('gear').textContent = String(h.gear === 0 ? 'R' : h.gear || '1');
          $('hud-car').textContent = vehicles[h.vehicle || 0]?.name || 'GT-01';
          $('race-time').textContent = formatTime(h.race_time);
          const item = items[h.item] || items[0];
          $('item-symbol').textContent = item[0];
          $('item-name').textContent = item[1];
          $('item-use').textContent = item[2];
          if(h.item === 3 && h.place === 1) $('item-use').textContent = 'NO TARGET AHEAD';
          $('item').style.borderColor = h.item ? '#9ddbc280' : '#d7e6e72a';
          const charge = Math.max(0, Math.min(1, h.drift_charge || 0));
          driftEl.style.display = h.drifting || charge > .02 ? 'block' : 'none';
          $('drift-label').textContent = charge >= .65 ? 'RELEASE TO BOOST' : 'BUILD YOUR DRIFT';
          const driftMeter = document.querySelector<HTMLElement>('#drift-meter i');
          if (!driftMeter) throw new Error('the Fire HUD is missing its drift meter');
          driftMeter.style.width = `${charge * 100}%`;
          const network = !practice ? wasm.online_status() : '';
          $('effect').textContent = network || (h.hit > .1 ? 'IMPACT · RECOVERING' : h.shield > .1 ? 'SHIELD ACTIVE' : h.grip > .1 ? 'GRIP ACTIVE' : h.boosting ? 'BOOST ACTIVE' : '');
          sound.update(h);
          if (h.countdown > 0.01) {
            stateEl.style.display = 'block';
            stateEl.textContent = String(Math.ceil(h.countdown));
          } else if (h.finished) {
            stateEl.style.display = 'none';
            if(!resultsShown) {
              resultsShown = true;
              $('result-title').textContent = h.place===1 ? 'VICTORY.' : 'RACE COMPLETE.';
              $('result-place').textContent = `P${h.place} / ${h.racers}`;
              $('result-time').textContent = formatTime(h.race_time);
              $('results').classList.remove('hidden');
              $('session-note').textContent = practice ? 'Try a different line. Save an item for the final lap.' : 'Race classified. Return to the garage to join or host the next race.';
              sound.cue(h.place===1 ? 1046 : 659, .7);
            }
          } else {
            stateEl.style.display = h.race_time > 0 && h.race_time < .65 ? 'block' : 'none';
            stateEl.textContent = 'GO';
          }
        } catch {}
        requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };
