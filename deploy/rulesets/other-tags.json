{
  "name": "other tags",
  "target": "tag",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "include": [
        "~ALL"
      ],
      "exclude": [
        "refs/tags/*-[0-9]*.[0-9]*.[0-9]*"
      ]
    }
  },
  "rules": [
    {
      "type": "creation"
    }
  ]
}
