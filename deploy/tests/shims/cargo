#!/usr/bin/env bash
# A fake `cargo` for the deploy tests.
#
# The only cargo the deploy scripts run LOCALLY is the health check through
# the public URL (wsbot / the fire probe), and there is no public URL in a
# test. Log the argv and pass: what is under test here is that the scripts
# reach the publish step with the right arguments, not that the probes work —
# the probes are exercised for real by test-host-loopback.sh.
set -uo pipefail
LOG="${SHIM_LOG:-/dev/null}"
{ printf 'cargo'; for a in "$@"; do printf ' [%s]' "$a"; done; printf '\n'; } >> "$LOG"

# The Pages fixture exercises the generated-input-to-emitted-module handoff.
# A webgen run therefore creates the two browser compiler inputs in both
# output trees; the npx shim emits recognisable JavaScript from that stage.
if [[ " $* " == *" run "* ]] && [[ " $* " == *" -p ember-webgen "* ]]; then
    output=""
    previous=""
    for argument in "$@"; do
        if [ "$previous" = "--out" ]; then output="$argument"; break; fi
        previous="$argument"
    done
    [ -n "$output" ] || { echo "cargo shim: ember-webgen run has no --out" >&2; exit 2; }
    for root in "$output/ts" target/web-generated/ts; do
        mkdir -p "$root"
        printf 'export const renderedHosts = true;\n' > "$root/hosts.ts"
        printf 'export const renderedLoader = true;\n' > "$root/loader.ts"
    done
    for root in "$output/node-ts" target/web-generated/node-ts; do
        mkdir -p "$root"
        printf 'export const renderedHostGate = true;\n' > "$root/check-hosts.mts"
        printf 'export const renderedHostGateTest = true;\n' > "$root/check-hosts.test.mts"
        printf 'export const renderedHostsTest = true;\n' > "$root/hosts.test.mts"
        printf 'export const renderedLoaderTest = true;\n' > "$root/loader.test.mts"
    done
    mapper="${CARGO_TARGET_DIR:-target}/release/ember-webgen"
    mkdir -p "$(dirname "$mapper")"
    printf '#!/bin/sh\ncat\n' > "$mapper"
    chmod +x "$mapper"
fi
# host.sh's fast wiring test asks this shim to materialize inert executables.
# The ordinary ssh-deploy tests leave these variables unset and retain the
# original log-and-succeed behaviour above.
if [ -n "${EMBER_FAKE_CARGO_TARGET:-}" ]; then
    example=""
    packages=""
    while [ $# -gt 0 ]; do
        case "$1" in
            -p) packages="$packages ${2:-}"; shift 2 ;;
            --example) example="${2:-}"; shift 2 ;;
            *) shift ;;
        esac
    done
    if [ -n "$example" ]; then
        mkdir -p "$EMBER_FAKE_CARGO_TARGET/release/examples"
        cp "$EMBER_FAKE_PROBE" "$EMBER_FAKE_CARGO_TARGET/release/examples/$example"
        chmod +x "$EMBER_FAKE_CARGO_TARGET/release/examples/$example"
    else
        mkdir -p "$EMBER_FAKE_CARGO_TARGET/release"
        for package in $packages; do
            cp "$EMBER_FAKE_SERVER" "$EMBER_FAKE_CARGO_TARGET/release/$package"
            chmod +x "$EMBER_FAKE_CARGO_TARGET/release/$package"
        done
    fi
fi
exit 0
