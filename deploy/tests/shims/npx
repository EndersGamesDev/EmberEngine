#!/usr/bin/env bash
# A fake npx for Pages TypeScript integration; version checks remain exact.
set -euo pipefail

LOG="${SHIM_LOG:-/dev/null}"
{ printf 'npx'; for argument in "$@"; do printf ' [%s]' "$argument"; done; printf '\n'; } >> "$LOG"

case " $* " in
    *" tsc --version "*) printf 'Version 5.9.3\n' ;;
    *)
        if [ "${SHIM_NPX_FAIL:-}" = 1 ]; then
            printf 'fixture TypeScript failure\n' >&2
            exit 2
        fi
        if [[ " $* " == *" tsc -p tsconfig.web.json "* ]] && [[ " $* " != *" --noEmit "* ]]; then
            mkdir -p target/web-generated/js
            printf 'export const generatedHosts = "npx-emitted-hosts";\n' \
                > target/web-generated/js/hosts.js
            printf 'export function emberLoad() { return "npx-emitted-loader"; }\n' \
                > target/web-generated/js/loader.js
            printf 'export {};\n' > target/web-generated/js/exhaustive-consumer.js
            mkdir -p target/web-generated/js/games/fire/v2
            cp target/web-generated/ts/games/fire/v2/race.ts \
                target/web-generated/js/games/fire/v2/race.js
            cp target/web-generated/ts/games/fire/v2/garage.ts \
                target/web-generated/js/games/fire/v2/garage.js
        fi
        ;;
esac
