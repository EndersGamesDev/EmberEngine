#!/usr/bin/env bash
# A fake `git` for deploy/tests/test-pages.sh. It supplies the build stamp,
# materializes the detached legacy seed, and records every attempted command.
set -euo pipefail

LOG="${SHIM_LOG:-/dev/null}"
{ printf 'git'; for a in "$@"; do printf ' [%s]' "$a"; done; printf '\n'; } >> "$LOG"

case "${1:-}" in
    ls-files)
        source=""
        take_next=""
        for arg in "$@"; do
            if [ -n "$take_next" ]; then source="$arg"; take_next=""; fi
            if [ "$arg" = -- ]; then take_next=1; fi
        done
        [ -n "$source" ] || { echo "git shim: ls-files needs a path" >&2; exit 97; }
        [ -f "${SHIM_GIT_TRACKED:?}" ] || { echo "git shim: tracked-file manifest is missing" >&2; exit 97; }
        while IFS= read -r path; do
            case "$path" in
                "$source"|"$source"/*) printf '%s\0' "$path" ;;
            esac
        done < "$SHIM_GIT_TRACKED"
        ;;
    rev-list) echo 1 ;;
    rev-parse) echo deadbee ;;
    log) echo "pages deploy test" ;;
    diff)
        if [ "${2:-}" = --cached ] && [ -f "${SHIM_GIT_INDEX:-/nonexistent}" ]; then
            exit 1
        fi
        ;;
    fetch) ;;
    worktree)
        case "${2:-}" in
            add)
                dest="${5:-}"
                mkdir -p "$dest"
                cp -R "${SHIM_PAGES_SEED:?}/." "$dest/"
                ;;
            remove) ;;
            *) echo "git shim: unsupported worktree command: $*" >&2; exit 97 ;;
        esac
        ;;
    show) echo "git shim: unexpected archive materialization" >&2; exit 97 ;;
    add) : > "${SHIM_GIT_INDEX:?}" ;;
    commit) ;;
    push)
        mkdir -p "${SHIM_PUBLISHED:?}"
        cp -R . "$SHIM_PUBLISHED/"
        ;;
    *) echo "git shim: unsupported command: $*" >&2; exit 97 ;;
esac
